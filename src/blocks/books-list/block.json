{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mm/books-list",
	"version": "0.1.0",
	"title": "Books List",
	"category": "design",
	"icon": "book-alt",
	"description": "A block to display a collection of books",
	"example": {},
	"supports": {
		"html": false
	},
	"textdomain": "books-list",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js",

	"attributes" : {
		"cardColor": {
			"type": "string",
			"default": "#ffffff"
		},
		"textColor": {
			"type": "string",
			"default": "#000000"
		},
		"headingColor": {
			"type": "string",
			"default": "#333333"
		},
		"numBooks": {
			"type": "number",
			"default": 6
		},
		"order": {
			"type": "string",
			"default": "ASC"
		}

	}
}
